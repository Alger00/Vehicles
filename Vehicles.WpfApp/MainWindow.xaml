<Window x:Class="Vehicles.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vehicles"
        Height="500"
        Width="1000">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Car Garage" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

            <ListBox x:Name="CarsListBox" Grid.Row="1" SelectionChanged="CarsListBox_SelectionChanged"/>

            <Button Content="Add Car" Grid.Row="2" Click="AddCar_Click" Margin="0,5"/>
        </Grid>
        <Grid Grid.Column="1" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Boat Garage" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

            <ListBox x:Name="BoatsListBox" Grid.Row="1" SelectionChanged="BoatsListBox_SelectionChanged"/>

            <Button Content="Add Boat" Grid.Row="2" Click="AddBoat_Click" Margin="0,5"/>

            <Button Content="Add Amphibious Car" Grid.Row="3" Click="AddAmphi_Click" Margin="0,5"/>
        </Grid>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="InfoTextBlock" Grid.Row="0" FontSize="16" Margin="0,0,0,10"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Distance (km):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="DistanceTextBox" Width="100" Text="10"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="DriveButton" Grid.Column="0" Content="Drive" Click="Drive_Click" Margin="0,0,5,0"/>

                <Button x:Name="SwimButton" Grid.Column="1" Content="Swim" Click="Swim_Click" Margin="0,0,5,0"/>

                <Button Grid.Column="2" Content="Remove" Click="Remove_Click"/>
            </Grid>

            <ListBox x:Name="LogListBox" Grid.Row="3"/>
        </Grid>
    </Grid>
</Window>